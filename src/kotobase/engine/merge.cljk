(ns kotobase.engine.merge
  "Deterministic, coordinator-free merge of diverged logical commits.

  Policy `kotobase.merge/v1` (kotobase ADR-2610101200). Pure: no I/O, no
  clock, no randomness. The caller supplies an already-fetched commit graph and
  an injected digest; every replica that holds the same ancestor closure and
  the same schema derives byte-identical merge commits.

  Semantics, in one paragraph: every transaction datom in the union of the
  heads' ancestor closures is an event stamped `[epoch commit-root index]`.
  Causality (ancestor closure, then tx order inside one commit) decides
  whenever it can: a retraction removes only the assertions it observed, and a
  cardinality-one assertion replaces only the values it observed. The stamp
  order decides only between causally concurrent events that the schema says
  cannot coexist: the latest stamp wins a cardinality-one attribute, the
  earliest stamp keeps a `:db/unique` value. Every such decision is written as
  an explicit datom into the merge commit's resolution transaction."
  (:refer-clojure :exclude [merge])
  (:require [kotobase.engine.canonical :as canonical]
            [kotobase.engine.identity :as identity]))

(defn- reject! [problem message data]
  (throw (ex-info message (assoc data :type :kotobase.merge/rejected
                                      :problem problem))))

;; ---------------------------------------------------------------------------
;; Graph

(defn- entry [graph root]
  (or (get graph root)
      (reject! :missing-ancestor "commit graph does not contain an ancestor"
               {:root root})))

(defn- verify-entry!
  "Bind ROOT to its commit bytes and the commit's :tx-root to its tx bytes.
  Signature/authority checks stay with the caller (as in frontier)."
  [digest root {:keys [commit tx]}]
  (let [commit (identity/logical-commit commit)]
    (when-not (= root (digest (identity/logical-commit-string commit)))
      (reject! :root-mismatch "commit root does not match its canonical bytes"
               {:root root}))
    (when-not (= (:tx-root commit) (digest (canonical/transaction-string tx)))
      (reject! :tx-root-mismatch "commit tx-root does not match its transaction"
               {:root root}))
    commit))

(defn- ancestry
  "Return {:commits {root commit} :closure {root #{ancestors incl. self}}} for
  the union of the closures of ROOTS. Verifies every reached entry and that
  every commit's epoch is exactly 1 + max(parent epochs)."
  [graph digest roots]
  (let [commits (loop [pending (vec roots) seen {}]
                  (if-let [root (peek pending)]
                    (let [pending (pop pending)]
                      (if (contains? seen root)
                        (recur pending seen)
                        (let [commit (verify-entry! digest root
                                                    (entry graph root))]
                          (recur (into pending (:parents commit))
                                 (assoc seen root commit)))))
                    seen))
        order (sort-by (fn [[root commit]] [(:epoch commit) root]) commits)]
    {:commits commits
     :closure
     (reduce
      (fn [closure [root {:keys [parents epoch]}]]
        (when (seq parents)
          (let [expected (inc (apply max (map #(:epoch (get commits %))
                                               parents)))]
            (when-not (= expected epoch)
              (reject! :invalid-epoch
                       "commit epoch must be 1 + max(parent epochs)"
                       {:root root :epoch epoch :expected expected}))))
        (assoc closure root
               (reduce (fn [acc parent]
                         (into acc (or (get closure parent)
                                       (reject! :cycle
                                                "commit graph is not acyclic"
                                                {:root root :parent parent}))))
                       #{root} parents)))
      {} order)}))

(defn- ancestor? [closure ancestor descendant]
  (contains? (get closure descendant) ancestor))

(defn reduce-heads
  "Distinct heads that are not an ancestor of another head, in canonical
  (ascending CID) order. Merging an ancestor is a no-op."
  [closure heads]
  (let [heads (identity/canonical-parents heads)]
    (filterv (fn [h] (not-any? #(and (not= h %) (ancestor? closure h %)) heads))
             heads)))

(defn merge-bases
  "Maximal common ancestors of HEADS (more than one in a criss-cross).
  Requires the closure map from `ancestry`."
  [closure heads]
  (let [closures (map #(get closure %) heads)
        common (filter (fn [c] (every? #(contains? % c) closures))
                       (first closures))]
    (->> common
         (filter (fn [c] (not-any? #(and (not= c %) (ancestor? closure c %))
                                   common)))
         sort
         vec)))

;; ---------------------------------------------------------------------------
;; Events

(defn- events [graph commits]
  (->> commits
       (mapcat (fn [[root commit]]
                 (map-indexed
                  (fn [index d]
                    (assoc d :root root :stamp [(:epoch commit) root index]))
                  (canonical/normalize-tx (:tx (get graph root))))))
       vec))

(defn- happens-before? [closure x y]
  (if (= (:root x) (:root y))
    (< (nth (:stamp x) 2) (nth (:stamp y) 2))
    (ancestor? closure (:root x) (:root y))))

(defn- cardinality-one? [schema a]
  (= :db.cardinality/one (:db/cardinality (get schema a))))

(defn- unique? [schema a]
  (some? (:db/unique (get schema a))))

(defn- kills?
  "Does event R, given that it happens after assertion A, remove A?"
  [schema a r]
  (if (= :retract (:op r))
    (= (:v r) (:v a))
    (and (cardinality-one? schema (:a a)) (not= (:v r) (:v a)))))

(defn- datom-key [{:keys [e a v]}] [e a v])

(defn- order-key [x] (canonical/canonical-string x))

(defn- live-assertions
  "Assertion events not removed by any causally later event on the same
  entity/attribute."
  [schema closure evs]
  (->> (group-by (juxt :e :a) evs)
       vals
       (mapcat (fn [group]
                 (filter (fn [a]
                           (and (= :assert (:op a))
                                (not-any? #(and (happens-before? closure a %)
                                                (kills? schema a %))
                                          group)))
                         group)))))

(defn- max-stamp [evs] (last (sort (map :stamp evs))))
(defn- min-stamp [evs] (first (sort (map :stamp evs))))

;; ---------------------------------------------------------------------------
;; Resolution

(defn- retract-vs-assert-conflicts
  "A present datom whose live assertion is concurrent with a retraction that
  no live assertion has since observed. Observed-remove semantics keep it;
  the merge re-asserts it so the decision is explicit in history."
  [closure evs live-by-datom]
  (let [retracts (group-by datom-key (filter #(= :retract (:op %)) evs))]
    (->> live-by-datom
         (keep (fn [[k lives]]
                 (let [open (filterv
                             (fn [r]
                               (and (some #(and (not (happens-before? closure % r))
                                                (not (happens-before? closure r %)))
                                          lives)
                                    (not-any? #(happens-before? closure r %)
                                              lives)))
                             (get retracts k))]
                   (when (seq open)
                     (let [[e a v] k]
                       {:kind :retract-vs-assert :e e :a a :v v
                        :resolution :assert-wins
                        :assert-commits (vec (sort (distinct (map :root lives))))
                        :retract-commits (vec (sort (distinct (map :root open))))})))))
         vec)))

(defn- cardinality-one-conflicts [schema live-by-datom]
  (->> live-by-datom
       (filter (fn [[[_ a _] _]] (cardinality-one? schema a)))
       (group-by (fn [[[e a _] _]] [e a]))
       (keep (fn [[[e a] values]]
               (when (< 1 (count values))
                 (let [ranked (sort-by (fn [[_ lives]] (max-stamp lives))
                                       values)
                       [[[_ _ winner] winner-lives]] (take-last 1 ranked)]
                   {:kind :cardinality-one :e e :a a
                    :winner winner
                    :winner-commit (second (max-stamp winner-lives))
                    :losers (->> (butlast ranked)
                                 (map (fn [[[_ _ v] _]] v))
                                 (sort-by order-key) vec)
                    :rule :latest-stamp}))))
       vec))

(defn- unique-conflicts [schema live-by-datom]
  (->> live-by-datom
       (filter (fn [[[_ a _] _]] (unique? schema a)))
       (group-by (fn [[[_ a v] _]] [a v]))
       (keep (fn [[[a v] holders]]
               (when (< 1 (count holders))
                 (let [ranked (sort-by (fn [[_ lives]] (min-stamp lives))
                                       holders)
                       [[[winner _ _] winner-lives]] ranked]
                   {:kind :unique :a a :v v
                    :winner winner
                    :winner-commit (second (min-stamp winner-lives))
                    :losers (->> (rest ranked)
                                 (map (fn [[[e _ _] _]] e))
                                 (sort-by order-key) vec)
                    :rule :earliest-stamp}))))
       vec))

(defn- sort-conflicts [conflicts]
  (vec (sort-by order-key conflicts)))

(defn resolve-state
  "Pure datom-level merge over an event set. Returns the visible datoms after
  resolution, the resolution transaction and the conflict report."
  [schema closure evs]
  (let [live-by-datom (group-by datom-key (live-assertions schema closure evs))
        ra (retract-vs-assert-conflicts closure evs live-by-datom)
        c1 (cardinality-one-conflicts schema live-by-datom)
        c1-losers (set (for [{:keys [e a losers]} c1, v losers] [e a v]))
        after-c1 (apply dissoc live-by-datom c1-losers)
        uq (unique-conflicts schema after-c1)
        uq-losers (set (for [{:keys [a v losers]} uq, e losers] [e a v]))
        visible (apply dissoc after-c1 uq-losers)
        retracts (for [[e a v] (concat c1-losers uq-losers)]
                   {:e e :a a :v v :op :retract})
        ;; A contested datom that then lost a cardinality/unique decision is
        ;; explained by that decision and retracted; report only survivors.
        ra (filterv #(contains? visible [(:e %) (:a %) (:v %)]) ra)
        re-asserts (for [{:keys [e a v]} ra]
                     {:e e :a a :v v :op :assert})]
    {:datoms (canonical/checkpoint-datoms
              (map (fn [[e a v]] {:e e :a a :v v}) (keys visible)))
     :tx (vec (concat (sort-by order-key (distinct retracts))
                      (sort-by order-key re-asserts)))
     :conflicts (sort-conflicts (concat ra c1 uq))}))

;; ---------------------------------------------------------------------------
;; Public

(defn- same-field! [commits heads field]
  (let [values (set (map #(get-in commits [% field]) heads))]
    (when-not (= 1 (count values))
      (reject! :incompatible-heads
               (str "merge heads disagree on " (name field))
               {:field field :values values}))))

(defn merge
  "Deterministically merge HEADS.

  Options:
  - `:graph`  {root {:commit logical-commit :tx tx-data}} covering the full
    ancestor closure of every head (to genesis).
  - `:heads`  roots to merge, in any order, duplicates allowed.
  - `:schema` {attr {:db/cardinality .. :db/unique ..}} for the heads'
    common `:schema-root`; the caller binds it to that root.
  - `:digest` (fn [canonical-string] -> CID string), the same digest used to
    address the graph.

  Returns `{:status :fast-forward :root r}` when one head already contains
  the others, otherwise `{:status :merged :root :commit :tx :datoms
  :conflicts :bases :heads}`. The result depends only on the set of heads:
  argument order and duplicates cannot change the merge commit's CID."
  [{:keys [graph heads schema digest]}]
  (when-not (fn? digest)
    (reject! :invalid-digest "merge requires a digest function" {}))
  (when-not (and (sequential? heads) (seq heads))
    (reject! :invalid-heads "merge requires at least one head" {:heads heads}))
  (let [{:keys [commits closure]} (ancestry graph digest heads)
        heads (reduce-heads closure heads)]
    (if (= 1 (count heads))
      {:status :fast-forward :root (first heads) :heads heads}
      (do
        (when (< identity/max-merge-parents (count heads))
          (reject! :too-many-parents "merge exceeds max-merge-parents"
                   {:count (count heads) :max identity/max-merge-parents}))
        (doseq [field [:database-id :schema-root :model-contract-root
                       :admission-policy-root]]
          (same-field! commits heads field))
        (let [{:keys [datoms tx conflicts]}
              (resolve-state schema closure (events graph commits))
              head-commit (get commits (first heads))
              commit {:format identity/merge-commit-format
                      :merge-policy identity/merge-policy
                      :database-id (:database-id head-commit)
                      :epoch (inc (apply max (map #(:epoch (get commits %))
                                                  heads)))
                      :parents heads
                      :tx-root (digest (canonical/transaction-string tx))
                      :logical-checkpoint-root
                      (digest (canonical/checkpoint-string datoms))
                      :schema-root (:schema-root head-commit)
                      :model-contract-root (:model-contract-root head-commit)
                      :admission-policy-root
                      (:admission-policy-root head-commit)}]
          {:status :merged
           :root (digest (identity/logical-commit-string commit))
           :commit (identity/logical-commit commit)
           :tx tx
           :datoms datoms
           :conflicts conflicts
           :bases (merge-bases closure heads)
           :heads heads})))))

(defn state
  "Visible datoms at ROOT under the same causal semantics `merge` uses.
  For a v1 linear chain this is ordinary replay."
  [{:keys [graph root schema digest]}]
  (let [{:keys [commits closure]} (ancestry graph digest [root])]
    (:datoms (resolve-state schema closure (events graph commits)))))

(defn verify-merge
  "Recompute the v2 commit at ROOT from its parents and require identical
  bytes. A merge commit whose resolution, epoch, checkpoint, or parent set
  (including a redundant ancestor parent) differs from the deterministic
  result is rejected. Returns the recomputed merge result."
  [{:keys [graph root schema digest]}]
  (let [{:keys [commit tx]} (entry graph root)
        _ (verify-entry! digest root (entry graph root))
        _ (when-not (identity/merge-commit? commit)
            (reject! :not-a-merge "verify-merge requires a v2 commit"
                     {:root root}))
        result (merge {:graph graph :heads (:parents commit)
                       :schema schema :digest digest})]
    (when-not (and (= :merged (:status result))
                   (= root (:root result))
                   (= (canonical/normalize-tx tx) (:tx result)))
      (reject! :merge-mismatch
               "merge commit differs from the deterministic merge of its parents"
               {:root root :expected (:root result)}))
    result))
